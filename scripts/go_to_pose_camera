#!/usr/bin/env python3

import os

import rclpy
import yaml
from ament_index_python.packages import get_package_share_directory
from stable_baselines3 import A2C, PPO
from stable_baselines3.common.env_util import make_vec_env
from ros_gymnasium.register_env import register_envs

ALGORITHMS = {"PPO": PPO, "A2C": A2C}


def load_training_params():
    """Load training_params.yaml from the path given by the launch file, or the installed default."""
    default_path = os.path.join(get_package_share_directory("ros_gymnasium"), "config", "training_params.yaml")

    node = rclpy.create_node("ros_gymnasium_trainer")
    path = node.declare_parameter("training_params_path", default_path).value
    node.destroy_node()

    with open(path, "r") as file:
        return yaml.safe_load(file)["training_params"]


def main(args=None):
    rclpy.init(args=args)

    params = load_training_params()
    register_envs()

    algorithm = params["algorithm"]
    run_name = f"{params['env_id']}-{algorithm}-seed{params['seed']}"

    # Create the environment
    env = make_vec_env(params["env_id"], n_envs=1)

    # Create the agent
    model = ALGORITHMS[algorithm](
        params["policy"],
        env,
        verbose=1,
        seed=params["seed"],
        tensorboard_log=os.path.join(params["tensorboard_log"], run_name),
        policy_kwargs={"normalize_images": False},
        **params["algorithm_params"],
    )

    print(f"Training start: {run_name}")

    # Train the model
    model.learn(total_timesteps=params["total_timesteps"], progress_bar=True)

    # Save the model
    model.save(f"{run_name}.zip")

    # Close the environment
    env.close()

    try:
        if rclpy.ok():
            print("Shutting down ROS 2...")
            rclpy.shutdown()
    except Exception as e:
        print(f"Error during shutdown: {e}")

    return 0

if __name__ == "__main__":
    main()
